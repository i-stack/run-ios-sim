# 远程连接越狱 iOS 设备配置示例
# 请根据您的实际设备信息修改以下配置

# 设备基本信息
REMOTE_UDID=2FCC54C4AB7082F8192FDA979EB8758A3BFEB0F6
REMOTE_DEVICE_NAME=Remote Jailbroken iPhone
REMOTE_PLATFORM_VERSION=15.8.2

# 设备网络信息
DEVICE_IP=192.168.1.100
DEVICE_PORT=8100

# WebDriverAgent 配置
WDA_LOCAL_PORT=8100
WDA_BASE_URL=http://192.168.1.100:8100

# Appium 服务器配置
APPIUM_HOST=localhost
APPIUM_PORT=4723

# Viber 应用配置
VIBER_BUNDLE_ID=com.viber.Viber
VIBER_APP_PATH=

# 越狱设备特定配置
USE_XCTEST=false
USE_WDA=true
BOOTSTRAP_PATH=/usr/local/lib/node_modules/appium/node_modules/appium-webdriveragent
AGENT_PATH=/usr/local/lib/node_modules/appium/node_modules/appium-webdriveragent/WebDriverAgent.xcodeproj

# 连接配置
CONNECTION_RETRY_COUNT=3
CONNECTION_RETRY_TIMEOUT=120000
NEW_COMMAND_TIMEOUT=60

# 测试配置
TEST_PHONE_NUMBER=+8613800138000
TEST_DEVICE_ID=remote_jailbroken_device

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/remote-jailbroken.log 