{
	"name": "viber-appium-automation",
	"version": "1.0.0",
	"description": "Appium automation testing for Viber iOS app",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node src/index.ts",
		"websocket": "ts-node src/index.ts",
		"test": "jest",
		"build:prod": "ts-node build-production.ts",
		"multi-test": "ts-node multi-device-test.ts",
		"remote-test": "ts-node remote-connection-test.ts",
		"non-jailbroken": "ts-node non-jailbroken-solution.ts",
		"appium": "ts-node start-appium.ts",
		"appium:start": "appium server --port 4723 --use-plugins=inspector --allow-cors",
		"appium:multi": "ts-node src/scripts/start-multi-appium.ts",
		"jailbroken:test": "ts-node src/scripts/test-jailbroken-device.ts",
		"jailbroken:connect": "ts-node src/scripts/multi-session-example.ts",
		"jailbroken:simple": "ts-node src/scripts/simple-jailbroken-test.ts",
		"debug:appium": "ts-node src/scripts/debug-appium.ts",
		"debug:detailed": "ts-node src/scripts/detailed-debug.ts",
		"jailbroken:w3c": "ts-node src/scripts/w3c-compliant-test.ts",
		"test:simulator": "ts-node src/scripts/simulator-test.ts",
		"jailbroken:remote": "ts-node src/scripts/test-remote-jailbroken.ts",
		"check:remote": "ts-node src/scripts/check-remote-connection.ts",
		"update:env": "ts-node src/scripts/update-env.ts",
		"ping:device": "ts-node src/scripts/ping-device.ts",
		"verify:wda": "ts-node src/scripts/verify-wda.ts",
		"guide:wda": "ts-node src/scripts/manual-wda-install.ts",
		"test:ports": "ts-node src/scripts/test-alternative-ports.ts",
		"check:ssh": "ts-node src/scripts/check-ssh.ts",
		"alternative:connection": "ts-node src/scripts/alternative-connection.ts",
		"http:automation": "ts-node src/scripts/http-automation.ts",
		"diagnose:ssh": "ts-node src/scripts/ssh-diagnostic.ts",
		"ssh:connect": "ts-node src/scripts/ssh-connect.ts",
		"check:xcode-wda": "ts-node src/scripts/check-xcode-wda.ts",
		"guide:xcode-wda": "ts-node src/scripts/xcode-wda-guide.ts",
		"diagnose:wda": "ts-node src/scripts/diagnose-wda.ts",
		"start:appium": "ts-node src/scripts/start-appium-server.ts"
	},
	"dependencies": {
		"appium": "^2.2.3",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"node-fetch": "^3.3.2",
		"webdriverio": "^8.24.0",
		"winston": "^3.11.0",
		"ws": "^8.14.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.15",
		"@types/express": "^4.17.20",
		"@types/jest": "^29.5.6",
		"@types/node": "^20.8.0",
		"@types/ws": "^8.5.8",
		"appium-xcuitest-driver": "^9.10.1",
		"jest": "^29.7.0",
		"ts-node": "^10.9.1",
		"typescript": "^5.2.2",
		"vitepress": "^1.2.2"
	},
	"keywords": [
		"appium",
		"automation",
		"ios",
		"viber",
		"testing"
	],
	"author": "",
	"license": "MIT"
}
