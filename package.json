{
	"name": "viber-appium-automation",
	"version": "1.0.0",
	"description": "Appium automation testing for Viber iOS app",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node src/index.ts",
		"test": "ts-node src/flow/register.ts",
		"setup": "node setup.js",
		"appium": "appium server --port 4723 --use-plugins=inspector --allow-cors"
	},
	"dependencies": {
		"appium": "^2.19.0",
		"appium-inspector-plugin": "^2025.7.3",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"node-fetch": "^3.3.2",
		"webdriverio": "^9.18.4",
		"winston": "^3.17.0",
		"ws": "^8.18.3",
		"dotenv": "^17.2.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.1.0",
		"@types/ws": "^8.18.1",
		"@wdio/globals": "^9.17.0",
		"appium-xcuitest-driver": "^9.10.1",
		"jest": "^30.0.5",
		"npm-check-updates": "^18.0.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.2",
		"vitepress": "^1.6.3"
	},
	"keywords": [
		"appium",
		"automation",
		"ios",
		"viber",
		"testing"
	],
	"author": "",
	"license": "MIT"
}
