{
	"name": "viber-appium-automation",
	"version": "1.0.0",
	"description": "Appium automation testing for Viber iOS app",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node src/index.ts",
		"websocket": "ts-node src/index.ts",
		"test": "jest",
		"build:prod": "ts-node build-production.ts",
		"multi-test": "ts-node multi-device-test.ts",
		"remote-test": "ts-node remote-connection-test.ts",
		"non-jailbroken": "ts-node non-jailbroken-solution.ts",
		"appium": "ts-node start-appium.ts",
		"appium:start": "appium server --port 4723 --use-plugins=inspector --allow-cors"
	},
	"dependencies": {
		"appium": "^2.2.3",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"node-fetch": "^3.3.2",
		"webdriverio": "^8.24.0",
		"winston": "^3.11.0",
		"ws": "^8.14.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.15",
		"@types/express": "^4.17.20",
		"@types/jest": "^29.5.6",
		"@types/node": "^20.8.0",
		"@types/ws": "^8.5.8",
		"appium-xcuitest-driver": "^9.10.1",
		"jest": "^29.7.0",
		"ts-node": "^10.9.1",
		"typescript": "^5.2.2",
		"vitepress": "^1.2.2"
	},
	"keywords": [
		"appium",
		"automation",
		"ios",
		"viber",
		"testing"
	],
	"author": "",
	"license": "MIT"
}
