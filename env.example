# WebSocket Server Configuration
WS_PORT=8080
WS_HOST=localhost

# Appium Configuration
APPIUM_HOST=localhost
APPIUM_PORT=4723

# iOS Device Configuration
IOS_DEVICE_NAME=iPhone
IOS_PLATFORM_VERSION=15.0
IOS_UDID=

# Viber App Configuration
VIBER_BUNDLE_ID=com.viber.Viber
VIBER_APP_PATH=

# Network Proxy Configuration (for capturing API calls)
PROXY_HOST=localhost
PROXY_PORT=8888

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/appium-automation.log

# Test Data Storage
TEST_DATA_DIR=./test-data
API_RESPONSES_DIR=./api-responses 