# 越狱 iOS 设备 Appium 配置示例

# ==================== 设备信息 ====================
# 越狱设备的 UDID（通过 iTunes 或 Xcode 获取）
JAILBROKEN_UDID=00008020-000D24C11234567E

# 设备名称
JAILBROKEN_DEVICE_NAME=Jailbroken iPhone 12

# iOS 版本
JAILBROKEN_PLATFORM_VERSION=14.0

# ==================== 网络连接 ====================
# 设备 IP 地址（确保设备与电脑在同一网络）
DEVICE_IP=192.168.1.100

# Appium 服务器配置
APPIUM_HOST=localhost
APPIUM_PORT=4723

# ==================== WebDriverAgent 配置 ====================
# WDA 本地端口
WDA_LOCAL_PORT=8100

# WDA 基础 URL
WDA_BASE_URL=http://192.168.1.100:8100

# WDA 路径配置
BOOTSTRAP_PATH=/usr/local/lib/node_modules/appium/node_modules/appium-webdriveragent
AGENT_PATH=/usr/local/lib/node_modules/appium/node_modules/appium-webdriveragent/WebDriverAgent.xcodeproj

# ==================== 应用配置 ====================
# Viber 应用 Bundle ID
VIBER_BUNDLE_ID=com.viber.Viber

# Viber 应用路径（如果使用 .ipa 文件）
VIBER_APP_PATH=

# ==================== 越狱设备特有配置 ====================
# 是否使用 XCTest（越狱设备通常设为 false）
USE_XCTEST=false

# 是否使用 WebDriverAgent
USE_WDA=true

# 是否显示 Xcode 日志
SHOW_XCODE_LOG=true

# 是否显示 iOS 日志
SHOW_IOS_LOG=true

# ==================== 连接配置 ====================
# 连接重试次数
CONNECTION_RETRY_COUNT=3

# 连接超时时间（毫秒）
CONNECTION_RETRY_TIMEOUT=120000

# 命令超时时间（秒）
NEW_COMMAND_TIMEOUT=60

# ==================== 测试配置 ====================
# 测试手机号
TEST_PHONE_NUMBER=+8613800138000

# 测试设备 ID
TEST_DEVICE_ID=jailbroken_device_1 